{
  "default": {
    "paths": [
      "features/**/*.feature"
    ],
    "require": [
      "src/test/**/*.ts"
    ],
    "requireModule": [
      "tsx"
    ],
    "format": [
      "summary",
      "html:test-results/cucumber-report.html"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  }
}
